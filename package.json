{
  "name": "@theleumas/provena",
  "version": "0.1.0-beta.2",
  "description": "Local lexical, semantic, and hybrid retrieval with source-level provenance.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "provena": "./cli/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./filesystem": {
      "types": "./dist/adapters/filesystem.d.ts",
      "import": "./dist/adapters/filesystem.js"
    },
    "./minilm": {
      "types": "./dist/adapters/minilm.d.ts",
      "import": "./dist/adapters/minilm.js"
    }
  },
  "files": [
    "dist",
    "cli",
    "README.md",
    "LICENSE",
    "docs/**/*.md",
    "!docs/benchmarks/**",
    "!docs/alpha5-hardening.md",
    "!docs/alpha6-answerability.md",
    "!docs/alpha6-c-validation.md",
    "!docs/alpha6-evidence-traces.md",
    "!cli/tests/**",
    "examples",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Leumas",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-leumas/provena.git"
  },
  "homepage": "https://github.com/the-leumas/provena#readme",
  "bugs": {
    "url": "https://github.com/the-leumas/provena/issues"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "demo": "node cli/cli.mjs",
    "search": "node cli/cli.mjs",
    "test:search": "npm run build && node --test cli/tests/*.test.mjs",
    "test:demo": "npm run build && node --test cli/tests/showcase.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/run.mjs",
    "docs:file-types": "npm run build && node scripts/file-types.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs && node scripts/lifecycle-benchmark.mjs && node scripts/retrieval-benchmark.mjs",
    "prepack": "npm run build && node scripts/file-types.mjs --check",
    "publish:beta": "npm publish --tag beta",
    "test:minilm": "npm run build && node tests/minilm.acceptance.mjs",
    "benchmark:minilm": "npm run build && node scripts/minilm-benchmark.mjs",
    "test:browser": "npm run build && node tests/browser.real.mjs",
    "test:browser:minilm": "npm run build && node tests/browser.real.mjs --minilm",
    "evaluate": "npm run build && node scripts/representative-evaluation.mjs",
    "evaluate:minilm": "npm run build && node scripts/representative-evaluation.mjs --minilm",
    "benchmark:scale": "npm run build && node scripts/scale-benchmark.mjs",
    "evaluate:evidence": "npm run build && node scripts/evidence-evaluation.mjs",
    "evaluate:evidence:minilm": "npm run build && node scripts/evidence-evaluation.mjs --minilm"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "playwright": "1.62.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild@0.25.5": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true
  },
  "keywords": [
    "retrieval",
    "search",
    "semantic-search",
    "hybrid-search",
    "lexical-search",
    "rrf",
    "provenance",
    "embeddings",
    "typescript",
    "in-memory"
  ]
}
